<?xml version="1.0" encoding="UTF-8"?>
<!--
  ===========================================================================
  AI-Enhanced Provider Credentialing Automation Platform
  Maven build descriptor for the Spring Boot backend service.


  The dependency set is deliberately small so that the prototype can be
  rebuilt on any machine with a JDK 17 toolchain and normal access to Maven
  Central. Every third-party library used is listed here together with the
  license under which it is redistributed (see Section 6 of the Milestone 3
  document, "Intellectual Property and Licensing").
  ===========================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot parent supplies curated dependency versions and plugin config. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>edu.gcu.capstone</groupId>
    <artifactId>credentialing-platform</artifactId>
    <version>1.0.0</version>
    <name>credentialing-platform</name>
    <description>AI-Enhanced Provider Credentialing Automation Platform</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- REST controllers, embedded Tomcat, Jackson JSON binding. Apache-2.0 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA/Hibernate object-relational mapping for the credentialing tables. Apache-2.0 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation (jakarta.validation) used on inbound request DTOs. Apache-2.0 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Embedded SQL database used for the prototype deployment. MPL-2.0 / EPL-1.0 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- PDF text-layer extraction and PDF report generation. Apache-2.0 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.31</version>
        </dependency>

        <!--
            Microsoft SQL Server JDBC driver. Activated only by the "sqlserver"
            profile; with no profile the platform uses the embedded H2 database
            and this driver is never loaded. The version is managed by the
            Spring Boot parent. MIT license.
        -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JUnit 5, AssertJ, Mockito and MockMvc for the module test suite. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>credentialing-platform</finalName>
        <plugins>
            <!-- Produces the executable fat JAR used for deployment. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
